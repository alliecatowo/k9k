<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  K9k is distributed outside the Mac App Store and is intentionally NOT
  sandboxed (ENABLE_APP_SANDBOX = NO): it reads ~/.kube kubeconfigs and
  credential plugins, spawns the bundled k9k-core helper, /usr/bin/ssh, zsh
  and user-configured scanner and plugin commands. Hardened runtime stays on.
  No sandbox entitlements are needed, so this dictionary is empty on purpose.
-->
<dict/>
</plist>
